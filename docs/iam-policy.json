{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "TextractSincronoEAssincrono",
      "Effect": "Allow",
      "Action": [
        "textract:DetectDocumentText",
        "textract:AnalyzeDocument",
        "textract:AnalyzeID",
        "textract:StartDocumentTextDetection",
        "textract:GetDocumentTextDetection"
      ],
      "Resource": "*"
    },
    {
      "Sid": "AcessoAoBucketDoLaboratorio",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject"],
      "Resource": "arn:aws:s3:::meu-bucket-textract-lab/*"
    }
  ]
}
